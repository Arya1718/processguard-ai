# =====================================================================
# ProcessGuard AI — local development environment
# Copy to .env and adjust if needed:  cp .env.example .env
# Every value here is a LOCAL DEV DEFAULT. No real secrets live here.
#
# AZURE NOTE: in staging/prod this same set of variables is backed by
# Azure Key Vault (via managed identity) instead of a .env file. The
# config loaders in both services read ONLY from the process
# environment, so swapping the source does not change any code.
# =====================================================================

# ---------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------
# Correlation IDs: header forwarded across tiers for request tracing.
PGAI_CORRELATION_HEADER=X-Correlation-Id

# ---------------------------------------------------------------------
# .NET middleware
# ---------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT is set in docker-compose.yml (Development).
#
# Prompt 7: REAL OIDC. The Prompt 1 dev-token JWT block is GONE. Tokens are
# issued by the identity provider (local OIDC stand-in now; Microsoft Entra
# ID in staging/prod) and validated with the standard JWT bearer handler:
# signature via the provider's JWKS, issuer, audience, lifetime.
#
# AZURE NOTE: pointing this at real Entra ID later is a CONFIGURATION change
# -- issuer URL, client id, discovery/jwks endpoints -- not a code rewrite.
# (These same values come from Azure Key Vault via managed identity in prod.)
PGAI_OIDC__AUTHORITY=http://oidc-provider:8090
PGAI_OIDC__ISSUER=http://oidc-provider:8090
PGAI_OIDC__INTERNALISSUER=http://localhost:8090
PGAI_OIDC__AUDIENCE=processguard-frontend
PGAI_OIDC__REQUIREHTTPSMETADATA=false

# Role->capability policy table (Prompt 7): EXTERNAL CONFIG, one copy shared
# verbatim by the .NET middleware and the Python agent-service (mounted into
# both containers by docker-compose.yml). Tune roles without a code change.
PGAI_RBAC__POLICYFILE=/app/config/rbac-policy.json

# Postgres (local) — stands in for Azure SQL
PGAI_CONNECTIONSTRINGS__POSTGRES=Host=postgres;Port=5432;Database=processguard;Username=pgai;Password=pgai_dev_password

# Redis (local) — used by middleware health/ready (cache + pub/sub stand-in)
PGAI_CONNECTIONSTRINGS__REDIS=redis:6379

# Python agent service base URL (from middleware container's perspective)
PGAI_AGENTSERVICE__BASEURL=http://agent-service:8000

# ---------------------------------------------------------------------
# Python agent service
# ---------------------------------------------------------------------
PGAI_SERVICE_NAME=processguard-agent-service
PGAI_LOG_LEVEL=INFO

# Postgres is used by health/ready checks (stand-in for Azure SQL)
PGAI_DATABASE__HOST=postgres
PGAI_DATABASE__PORT=5432
PGAI_DATABASE__NAME=processguard
PGAI_DATABASE__USER=pgai
PGAI_DATABASE__PASSWORD=pgai_dev_password

# Redis — pub/sub stand-in for Azure Service Bus (and cache later)
PGAI_REDIS__HOST=redis
PGAI_REDIS__PORT=6379
PGAI_REDIS__PASSWORD=

# ---------------------------------------------------------------------
# Identity provider (Prompt 7) -- local OIDC stand-in for Entra ID
# The provider issues short-lived RS256 tokens carrying Entra-style claims
# (roles[], site_id, site_name). Keys rotate per container start (dev only).
# In staging/prod this whole block becomes a real tenant configuration and
# the secrets live in Azure Key Vault via managed identity.
# ---------------------------------------------------------------------
OIDC_CLIENT_ID=processguard-frontend
OIDC_CLIENT_SECRET=processguard-frontend-secret
# API key guarding the provider's demo/test endpoints (identity list, test
# token minting) -- not part of the OIDC protocol, dev tooling only.
OIDC_API_KEY=oidc-dev-key-change-me
# Host-published port for the browser dev path, tests and curl debugging.
# The app itself reaches the provider through the same-origin /oidc proxy.
# OIDC_ALLOWED_REDIRECTS=http://localhost:5173/auth/callback

# ---------------------------------------------------------------------
# Python agent service -- second-layer token validation (defense in depth)
# The agent service is never directly internet-facing but does NOT blindly
# trust the middleware: it re-validates the forwarded bearer token against
# the provider's JWKS and enforces site scoping in its own queries.
# ---------------------------------------------------------------------
PGAI_OIDC__ISSUER=http://oidc-provider:8090
PGAI_OIDC__INTERNALISSUER=http://localhost:8090
PGAI_OIDC__AUDIENCE=processguard-frontend
PGAI_OIDC__JWKS_URL=http://oidc-provider:8090/jwks.json

# Detection agent (Prompt 2) -- anomaly scoring knobs
# static_z: allowed overshoot past the normal band, as a fraction of band width
# drift_z:  z-score vs the sensor's own rolling baseline before drift is flagged
PGAI_DETECTION__STATIC_Z=0.05
PGAI_DETECTION__DRIFT_Z=3.0
PGAI_DETECTION__MIN_SAMPLES=4
PGAI_DETECTION__CORRELATION_WINDOW_SECONDS=30
PGAI_DETECTION__MAX_GAP_SECONDS=90
PGAI_DETECTION__WINDOW_SIZE=40
PGAI_DETECTION__DB_RETRY_ATTEMPTS=3

# Sensor simulator (Prompt 2) -- reading cadence and scenario ramp
PGAI_SIMULATOR__INTERVAL_MIN_SECONDS=2
PGAI_SIMULATOR__INTERVAL_MAX_SECONDS=5
PGAI_SIMULATOR__RAMP_SECONDS=30
PGAI_SIMULATOR__STREAM=sensor-readings
PGAI_SIMULATOR__STREAM_MAXLEN=100000

# Prompt 8 -- real-data mode (docs/real-data-sources.md). Default synthetic;
# set SENSOR_DATA_SOURCE=tep_replay to stream REAL Tennessee Eastman Process
# data (Rieth et al., DOI 10.7910/DVN/6C3JR1) into the same stream. Requires
# the replay CSVs: run `python scripts/download_tep_data.py --from-small-tep
# data/small_tep.zip` (or plain, for the canonical Dataverse download).
SENSOR_DATA_SOURCE=synthetic
PGAI_TEP__TICK_SECONDS=3
PGAI_TEP__SKIP_FRACTION=0.5
PGAI_TEP__DATA_DIR=data/tep

# ---------------------------------------------------------------------
# LLM (Prompt 3) -- Groq stand-in for Azure OpenAI
# GROQ_API_KEY is REQUIRED for real inference. Without it (and with fake
# mode off) the agent-service refuses to start -- never silently misconfigured.
# Set PGAI_LLM__FAKEMODE=true for offline dev / CI / demo rehearsal.
# (In staging/prod the key comes from Azure Key Vault via managed identity.)
# ---------------------------------------------------------------------
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
PGAI_LLM__FAKEMODE=true
PGAI_LLM__BASE_URL=https://api.groq.com/openai/v1
PGAI_LLM__TIMEOUT_SECONDS=30
# Optional scripted responses (JSON array) for the fake client, FIFO order
# PGAI_LLM__FAKE_RESPONSES=["Most likely cause: ... (confidence 87%)\nEvidence:\n- ... [sensor reading]"]

# ---------------------------------------------------------------------
# Mock ERP/CMMS (Prompt 5) -- stand-in for Buckman's real ERP/CMMS
# The CMMS key is a SEPARATE credential: it is the only secret that can
# cause an external write, and it is used exclusively by the Action Agent
# through app/core/cmms_client.py (docs/security-model.md). In staging/prod
# this lives in Azure Key Vault under its own secret name, scoped to the
# workload identity the Action Agent runs as.
# ---------------------------------------------------------------------
CMMS_API_KEY=cmms-dev-key-change-me
PGAI_CMMS__BASE_URL=http://mock-erp-cmms:8100
PGAI_CMMS__API_KEY=cmms-dev-key-change-me
PGAI_CMMS__TIMEOUT_SECONDS=10
PGAI_CMMS__RETRY_ATTEMPTS=4
PGAI_CMMS__RETRY_BACKOFF_SECONDS=2

# ---------------------------------------------------------------------
# Prompt 9: observability (stand-in for Azure Monitor / App Insights)
# ---------------------------------------------------------------------
# OpenTelemetry exporter endpoint. In compose, this is the local collector.
# In staging/prod, point this at your Azure Monitor collector endpoint.
# PGAI_OTEL__DISABLE=true skips OTel init entirely (e.g. for unit tests).
PGAI_OTEL__EXPORTER_URL=http://otel-collector:4317
PGAI_OTEL__DISABLE=false
# LLM cost calculation overrides (optional; defaults to Groq published rates)
PGAI_LLM__COST_PER_1M_INPUT=
PGAI_LLM__COST_PER_1M_OUTPUT=
# Grafana credentials for local dev
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SLACK_API_URL=
SLACK_CHANNEL=#processguard-alerts

# ---------------------------------------------------------------------
# Frontend (Vite — only variables prefixed VITE_ are exposed to the app)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
